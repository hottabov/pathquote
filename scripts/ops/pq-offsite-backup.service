[Unit]
Description=PathQuote weekly off-site backup to Google Drive
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pq-offsite-backup.sh
StandardOutput=append:/var/log/pq-offsite-backup.log
StandardError=append:/var/log/pq-offsite-backup.log
