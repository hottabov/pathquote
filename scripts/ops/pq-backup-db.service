[Unit]
Description=PathQuote backup: database dump, daily (local + Google Drive mirror)
After=docker.service network-online.target
Wants=network-online.target
OnFailure=pq-backup-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pq-backup.sh db
StandardOutput=append:/var/log/pq-backup.log
StandardError=append:/var/log/pq-backup.log
