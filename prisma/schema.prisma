generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// DEVELOPER carries the exact same rights as ADMIN everywhere in the app
// (see isAdminRole, src/lib/roles.ts, which every "is this an admin?" check
// routes through) -- the only thing distinguishing it is that the support
// form (src/app/(app)/settings/support) addresses its message to whoever
// holds this role. Added rather than repurposing ADMIN because Postgres can
// add an enum value but can never drop one -- see migration
// z23_developer_role's own comment for why that made this the only
// direction worth building.
enum Role {
  ADMIN
  MANAGER
  DEVELOPER
}

enum DocumentStatus {
  DRAFT
  FINAL
}

enum LineKind {
  OPTION
  PRODUCT
  CUSTOM
}

// A discount is a mode plus a value rather than a bare percentage — see
// Document.discountMode/DocumentItem.discountMode below. Storing a mode
// (instead of two nullable columns, one per shape) makes "both set and
// disagreeing" unrepresentable. Migration z12_discount_mode renamed the old
// discountPct column to discountValue and widened it from Decimal(5,2) to
// Decimal(12,2) so a cash amount isn't capped at $999.99.
enum DiscountMode {
  PERCENT
  AMOUNT
}

// An export sale collected at the factory door is not a domestic taxable
// supply -- the meeting question left unanswered ("What if there's no GST?
// If it's Ex Works?"). DELIVERED is the default so every existing document
// keeps its current (taxed) behaviour; see the zero-tax rule applied in
// recalcDocument (src/lib/actions/documents.ts), the single place a
// document's effective tax rate is resolved.
enum DeliveryTerms {
  DELIVERED
  EX_WORKS
}

// Whether a quote has been sent for signature and how far it got. A separate
// column from DocumentStatus rather than new values on it: every
// `status === "FINAL"` check across finalize, pricing and the PDF route stays
// correct untouched, because signing is an orthogonal axis to draft/final.
//
// "Author signed but not yet sent" is deliberately NOT a value here -- it is
// NOT_SENT plus a Signature(AUTHOR) row. The same asymmetry carries the
// client's side: a drawn but unconfirmed client signature is VIEWED plus a
// Signature(CLIENT) row. In both cases the signature exists before the act
// that commits it, which is what gives each signer a window to change their
// mind (see docs/superpowers/specs/2026-09-07-quote-signing-design.md, D7).
//
// EXPIRED and REVOKED are absent for the same reason: neither is a fact
// about the document, only about the outstanding link, and both are already
// fully derived from SigningRequest.expiresAt/revokedAt by resolveLinkState
// (src/lib/signing/link.ts). Adding either here would be a second,
// independently-driftable place to record something that one column (and,
// for expiry, one comparison against the clock) already answers -- and
// Postgres can add an enum value but can never drop one, so it would be
// undroppable the moment it shipped.
enum SigningStatus {
  NOT_SENT
  SENT
  VIEWED
  SIGNED
  DECLINED
}

enum SignerRole {
  AUTHOR
  CLIENT
}

// What a catalogue product *is*, stated outright instead of being inferred
// from its code. Until migration z31_catalog_identity every "is this a
// machine?", "which order form?", "how wide?" question was answered by a
// regex over Product.code (/^M(3|5|7|10)(180|220|300|390)$/ and friends),
// which made the code an identifier the owner could never rename. The code
// is now a label; these columns carry the meaning. The full map of what the
// codes used to encode is in docs/audit/2026-09-05-catalog-proposal-v1.md.
enum ProductKind {
  MACHINE // a cutter: M, X, L series
  TABLE // EasyLoader
  FEEDER // EasyFeeder
  SPREADER // FabricPro
  SOFTWARE // PathWorks and its modules, Production Analyst, LS Convert
  SYSTEM // Leather Nesting System -- a bundle
  SERVICE // RSP, SERVICE
  CREDIT // TRADE-IN (see Product.isCredit, which stays the pricing engine's flag)
  ACCESSORY // HDRF, FP-TROLLEY -- anything else that ships
}

// Which production order form an item prints on. Null = no form (software,
// services, accessories, and machines whose form is not built yet -- L
// series, HDRF). Replaces the per-form `matches(code)` regexes in
// src/lib/production-forms/specs/*.
enum ProductionForm {
  M_SERIES
  EASYLOADER
  FABRICPRO
}

// What an option *is*, for the parts of the app that need to know: the
// order forms tick a box per role (src/lib/production-forms/specs/*), the
// EasyLoader builder derives its module lines by role
// (src/lib/production-forms/table-sections.ts), and the options editor locks
// the derived rows by role. Null is fine and common: an option with no role
// is priced and printed like any other, it just has no box on any form and
// lands on the "Additional items" sheet. Roles are per *kind of thing*, not
// per catalogue row -- ABR-M and ABR-L both carry ABR.
enum OptionRole {
  // Cutter options with a box on the M-Series form
  ABR
  AFP
  APM
  BCR
  BED
  CRATE
  DMT
  DR2
  DRG_1
  DRG_2
  DRG_3
  EDS
  EXH
  HDC
  HFV
  IJP
  IKA
  IKP
  MRK
  MTS
  MTS_TRAVEL
  OFD
  OFJ
  OFP
  PM
  PRM
  TRANSFORMER
  VRB
  WASTE_BIN
  // L-Series
  JTP
  L_EXTENDED
  L_TOOL
  // EasyLoader modules and fittings
  EL_DRIVE
  EL_CONVEYOR
  EL_STATIC
  EL_BUSBAR
  EL_RAIL
  EL_ROLL_FEED
  EL_ROLL_HOLDER
  EL_SYNC
  // FabricPro
  TPL
  // Services sold as option lines
  INSTALL
  TRAINING
  // Software mistakenly sold as an option (PTW, PRA-L) -- retired in
  // catalogue v2, role kept so the rows can be identified until then
  SOFTWARE
  // Sets of consumables (drills)
  CONSUMABLE
}

model Region {
  id              String           @id @default(cuid())
  code            String           @unique // AU, US, UK
  name            String
  currency        String // AUD, USD, GBP
  taxName         String // GST, Sales Tax, VAT
  taxRate         Decimal          @db.Decimal(5, 2) // 10.00
  entityName      String // Pathfinder Australia Pty Ltd
  entityLegalId   String? // ABN 64 072 458 667
  entityAddress   String?
  bankDetails     Json?
  logoUrl         String?
  footerText      String?
  maxDiscountPct  Decimal?         @db.Decimal(5, 2) // AU: 10, US: 15 -- discount cap enforced against a document's region (see setItemDiscount/setDocumentDiscount in src/lib/actions/documents.ts); not shown in the catalog UI.
  // The mirror of maxDiscountPct: how far ABOVE list a distributor may price
  // (Ross: "he's got a minimum selling price. And a maximum selling price.
  // And those rules apply to the LLC as well."). Null means no ceiling, same
  // "unset changes nothing" contract maxDiscountPct already has. Enforced
  // via the same concession machinery as the discount cap -- a negative
  // concession is a markup -- see documentConcession/recalcAndEnforce.
  maxMarkupPct    Decimal?         @db.Decimal(5, 2)
  active          Boolean          @default(true)
  /// The standard-terms figures the legal documents quote back at the
  /// customer. Region-level because a region is effectively its own
  /// company, with its own lead times and warranty. Defaults are the
  /// figures the original Word template carried and the code hardcoded
  /// until now (src/lib/quotation-data.ts's globalVars).
  deliveryWeeks    Int @default(14)
  installationDays Int @default(2)
  trainingDays     Int @default(3)
  warrantyMonths   Int @default(12)
  users           User[]
  companies       Company[]
  prices          Price[]
  documents       Document[]
  quoteDocuments  QuoteDocument[]
  supportMessages SupportMessage[]
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  emailVerified     DateTime?
  name              String?
  phone             String?
  image             String?
  // The manager's saved signature, drawn once in Account. Copied onto each
  // quote at signing time -- see Signature.imageUrl.
  signatureUrl      String?
  passwordHash      String?
  role              Role                @default(MANAGER)
  regionId          String?
  region            Region?             @relation(fields: [regionId], references: [id])
  active            Boolean             @default(true)
  documents         Document[]
  accounts          Account[]
  sessions          Session[]
  companiesOwned    Company[]           @relation("CompanyOwner")
  catalogVisibility CatalogVisibility[]
  supportMessages   SupportMessage[]
  catalogImports    CatalogImport[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  // SHA-256 of the challenge nonce handed to the browser that requested this
  // link, as an httpOnly cookie. Present it back and sign-in needs no click;
  // absent or wrong (a link scanner, or the same person's phone) and the
  // confirm button is shown instead. See src/lib/auth/magic-challenge.ts.
  //
  // Nullable on purpose, and never backfilled: NULL means "issued before this
  // column existed", and those rows consume on first verify exactly as they
  // always did, so links in flight across the deploy keep working. @auth/core
  // writes this row itself and knows nothing about this column, so it is
  // filled by the adapter wrapper in src/lib/auth/adapter.ts.
  challengeHash String?

  @@unique([identifier, token])
}

model Series {
  id                String                @id @default(cuid())
  code              String                @unique // M, X, L, P, SW, LNS, EL, EF, FP, SVC
  name              String // M-Series, X-Calibre...
  maxDiscountPct    Decimal?              @db.Decimal(5, 2) // unused: discount caps moved to Region.maxDiscountPct; column kept, not read anywhere
  sortOrder         Int                   @default(0)
  imageUrl          String? // admin override for the /catalog series card image; null falls back to the first active product's imageUrl -- see listSeriesWithCounts in src/lib/queries/catalog.ts
  /// The category's quote copy: the prose printed under a product's heading
  /// in the Equipment Detail section, authored once per category and shared
  /// by every product in it. HTML, and may contain `{{token}}` placeholders
  /// resolved per product at render time — see src/lib/quote-variables.ts for
  /// the token list and which of them a given category may use. Null or
  /// empty prints nothing at all under the heading, which is the state every
  /// category starts in. Replaces the old Product.contentBlockKey ->
  /// ContentBlock lookup: one text per category rather than a key on all 57
  /// products pointing into a separate table.
  quoteDescription  String?
  products          Product[]
  compat            OptionCompatibility[]
  catalogVisibility CatalogVisibility[]
}

model Product {
  id                String                @id @default(cuid())
  // A label. Unique, printed on quotes, shown in lists -- and free to change:
  // nothing in src/ branches on its value (migration z31_catalog_identity;
  // see ProductKind above). Renaming it is a plain update; no history of old
  // codes is kept (migration z32_drop_legacy_codes).
  code              String                @unique // M-5180
  seriesId          String
  series            Series                @relation(fields: [seriesId], references: [id])
  name              String
  description       String?
  kind              ProductKind           @default(ACCESSORY)
  form              ProductionForm?
  // Typed by productSpecsSchema (src/lib/validation/product-specs.ts):
  // { cutHeightCm, cutWidthCm, tableWidthMm, paperWidthMm, modelTier,
  //   widthCode, extended, belt, softwareMode, pathworksModule }. What the
  // quotation's spec sentence, the order forms' model/width boxes and the
  // EasyLoader form's printed-width box read, instead of parsing the code.
  specs             Json?
  // Options that belong to this product rather than to a series -- the
  // EasyLoader's modules ("EL-2020-DM12" is a module *of* EL-2020). Replaces
  // the `${itemCode} ${suffix}` code template in table-sections.ts.
  ownedOptions      Option[]              @relation("OptionParentProduct")
  imageUrl          String?
  active            Boolean               @default(true)
  sortOrder         Int                   @default(0)
  // A credit product (today: the TRADE-IN catalogue product -- John: "we
  // should create another product called trade-in, so that way the
  // terminology is correct... it's a line item. It's a product. You're
  // selling a trade in. It's a negative value") subtracts its amount from a
  // quote instead of adding it. Deliberately NOT a negative unitPrice on the
  // item -- a salesperson always types a positive number here, and only the
  // reader of this flag (the pricing engine's sign, and the sheets'
  // rendering) ever treats it as a reduction. That keeps "sell a trade-in
  // for $20,000" and "accidentally type $20,000 instead of -$20,000" simply
  // not the same mistake anymore: a credit item's arithmetic sign comes from
  // the product, never from what was typed. See the doc comment on
  // `EngineItem.isCredit` in src/lib/pricing.ts for how this is consumed.
  // Migration z16_product_is_credit adds this column with its default, so
  // every existing product is unaffected.
  isCredit          Boolean               @default(false)
  // True when a salesperson earns no commission on this product -- named
  // for what it means to the reader ("this line pays no commission"), not
  // "commissionable: false" (a double negative once it's unchecked in the
  // UI) and not prefixed "is" like isCredit above, since `active` already
  // set this model's convention for a plain descriptive boolean name. Read
  // live off the joined product, same rule as isCredit (see
  // EngineItem.isNoCommission's doc comment in src/lib/pricing.ts) rather
  // than snapshotted onto DocumentItem, so changing it in the catalogue
  // takes effect on every quote that reads the item afterwards. Migration
  // z25_no_commission adds this column with its default, so every existing
  // product is unaffected.
  noCommission      Boolean               @default(false)
  prices            Price[]
  compat            OptionCompatibility[]
  docItems          DocumentItem[]
  catalogVisibility CatalogVisibility[]

  // Every catalogue page that lists products narrows by series first --
  // seriesProductsResult (src/lib/queries/catalog.ts), behind both
  // listProductsBySeries and listProductsBySeriesById, and
  // getSeriesFallbackImageUrl alongside it. `code` is unique but says
  // nothing about which series a row belongs to, so without this the
  // /catalog/[seriesId] page reads the whole product table on every request
  // to return one series' worth of rows.
  @@index([seriesId])
}

model Option {
  id                       String                      @id @default(cuid())
  // A label, same contract as Product.code: unique, renameable, never
  // branched on. See migration z31_catalog_identity.
  code                     String                      @unique // MTS, HFV, VRB-180...
  name                     String
  shortDescription         String?
  role                     OptionRole?
  // Set for options that are part of one product rather than fitted to a
  // series -- today the EasyLoader modules and fittings. Null for everything
  // fitted by series compatibility.
  parentProductId          String?
  parentProduct            Product?                    @relation("OptionParentProduct", fields: [parentProductId], references: [id])
  // Physical length one unit of this option adds, in metres (1.2 for an
  // EasyLoader module, 1 for a metre of MTS travel). What the options editor
  // shows beside the quantity stepper (src/lib/option-length.ts) -- it used
  // to parse "1.2M" out of the name.
  unitLengthM              Decimal?                    @db.Decimal(6, 2)
  attributeSchema          Json? // e.g. [{key:"metres",label:"Travel (m)",type:"number"}]
  imageUrl                 String?
  active                   Boolean                     @default(true)
  sortOrder                Int                         @default(0)
  // Same flag, same reasoning, as Product.noCommission above -- an option
  // line (e.g. Installation/Training on the North America price list) can
  // be excluded from commission independently of the item it's attached
  // to. Migration z25_no_commission adds this column with its default, so
  // every existing option is unaffected.
  noCommission             Boolean                     @default(false)
  prices                   Price[]
  compat                   OptionCompatibility[]
  // Which OptionConflictGroup(s) this option belongs to -- see that model's
  // comment below for why group membership, not a pairwise row, is how two
  // options are said to conflict.
  conflictGroupMemberships OptionConflictGroupMember[]

  // The EasyLoader builder asks "which options does THIS product own, with
  // WHICH role" on every layout change (findOwnedOption,
  // src/lib/production-forms/table-sections.ts).
  @@index([parentProductId])
}

// A named set of options where at most one may be fitted to the same item
// -- e.g. "Knife tools -- fit one only". Supersedes migration
// z20_option_conflict's OptionConflict (one row per UNORDERED PAIR of
// conflicting options): the owner clarified the real case is three or more
// mutually exclusive options ("Це може бути 3 і більше опцій які між собою
// не сумісні"), and a pairwise table can only express that as a clique --
// three mutually exclusive options need three pairwise rows, five need ten,
// and an admin who enters nine of those ten leaves a half-conflict in the
// catalogue that the schema has no way to catch. Storing the group directly
// makes that failure mode unrepresentable: an option either is or isn't a
// member, full stop, and "two options conflict" becomes "they share at
// least one group" (see conflictPartnersByGroup, src/lib/catalog-compat.ts,
// which every reader -- the builder's isOptionDisabled caller and
// setItemOptions -- goes through). A plain pairwise conflict is just the
// two-member case of this, not a separate concept.
//
// `name` isn't decoration -- it's what the catalogue admin (and the
// builder's disabled-option message, see isOptionDisabled) can quote when
// explaining a block, so every group needs one an admin will recognise at a
// glance.
//
// A group with 0 or 1 members is legal but inert (blocks nothing) --
// nothing here forbids it, since an admin building a group up necessarily
// starts with one member before adding a second.
//
// z20_option_conflict's OptionConflict is dropped in this same migration
// (z21_option_conflict_groups) rather than kept alongside this: it shipped
// empty (no seed data, and per the owner's own words above, no admin had
// concrete pairs to enter yet), so there is no data to migrate, only a
// mechanism to replace. z20 itself is left in place, unedited -- the owner
// may already have applied it.
model OptionConflictGroup {
  id      String                      @id @default(cuid())
  name    String
  members OptionConflictGroupMember[]
}

// One row per (group, option) membership. Table/column shape verified
// against "OptionCompatibility" in prisma/migrations/0_init/migration.sql --
// same id/two-required-relation-columns/@@unique shape. Both FKs cascade on
// delete (like CatalogVisibility, unlike OptionCompatibility's SET NULL): a
// membership row means nothing once either its group or its option is gone,
// so deleting either must never leave an orphaned row behind. Unique on
// (groupId, optionId) so an option can't be added to the same group twice,
// but nothing here stops it belonging to several different groups at once
// (see the OptionConflictGroup comment above) -- unlike OptionConflict's
// self-pair guard, there's no analogous "impossible" membership shape to
// check for here, so no extra CHECK constraint is needed in the migration.
model OptionConflictGroupMember {
  id       String              @id @default(cuid())
  groupId  String
  group    OptionConflictGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  optionId String
  option   Option              @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([groupId, optionId])
  // The unique above is keyed groupId-first, which answers "who is in this
  // group" (setConflictGroupMembers, src/lib/actions/catalog.ts) but not the
  // direction the builder actually asks in: listCompatibleOptions
  // (src/lib/queries/documents.ts) and setItemOptions
  // (src/lib/actions/documents.ts) both load
  // `conflictGroupMemberships` off a set of Options, i.e. filter on optionId
  // alone, which a groupId-leading index cannot serve. That runs on every
  // render of the item options editor, so it gets its own index.
  @@index([optionId])
}

model OptionCompatibility {
  id        String   @id @default(cuid())
  optionId  String
  option    Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  seriesId  String? // compatible with whole series
  series    Series?  @relation(fields: [seriesId], references: [id])
  productId String? // or a specific product
  product   Product? @relation(fields: [productId], references: [id])

  @@unique([optionId, seriesId, productId])
  // The unique above leads with optionId, so it serves "which series/products
  // is THIS option compatible with" (listOptionCompatibility,
  // src/lib/actions/catalog.ts) but is useless for the question the builder
  // asks far more often, and in the opposite direction: given an item's
  // product and its series, which options may be fitted? That is
  // compatibilityOrFilter (src/lib/catalog-compat.ts) -- an OR over
  // `{ seriesId }` and `{ productId }` with no optionId in sight -- used by
  // listCompatibleOptions (src/lib/queries/documents.ts) to draw the options
  // list and again by setItemOptions (src/lib/actions/documents.ts) to
  // re-validate what came back. Two single-column indexes rather than one
  // composite because the OR's two branches are independent: Postgres can
  // bitmap-OR them, whereas a composite on (seriesId, productId) would only
  // ever have its first column used here.
  @@index([seriesId])
  @@index([productId])
}

// One row per (user x series-or-product) pair that is HIDDEN from that
// user's catalogue -- Ross, on a reseller not yet cleared to sell the
// Excalibur X series: "we don't want him to even see the Excalibur." A zero
// price was rejected for this (Vadym: "just put zero, zero in the
// price" / Ross: "No, no... he's not -- we're not allowing him to sell it
// at the moment") -- the product must be absent, not unaffordable, so this
// is a visibility gate, not a pricing one.
//
// Scoped to an individual user, not a region -- shipped region-scoped
// (z17_catalog_visibility) but the owner corrected the requirement: two
// salespeople in the same region can need different catalogues ("є менеджер
// А і менеджер Б в USA... А не може продавати X-Calibre... Наразі
// візабіліті налаштовано на регіон, а потрібно на менеджера. Регіон тут ні
// до чого" -- there's manager A and manager B in the USA, A can't sell the
// X-Calibre, visibility is currently set up per region but needs to be per
// manager, region has nothing to do with it). Region-as-default-with-
// per-user-exceptions was considered and rejected by the owner in favour of
// per-user only, so there is no region layer here at all -- see migration
// z22_catalog_visibility_per_user, which replaced the regionId column with
// this userId one outright.
//
// Mirrors the series-or-product reference shape `OptionCompatibility`
// already uses above (exactly one of seriesId/productId set per row) so the
// codebase has one way of expressing "this catalogue thing, for that scope"
// rather than two.
//
// Deliberately stores what's HIDDEN, not what's visible -- an allow-list
// would need seeding for every existing product the moment a new user is
// added, and again for every existing user the moment a new product is
// added. A user with no rows here sees the *whole* catalogue by default, so
// (a) onboarding a new salesperson never starts with an empty catalogue
// someone has to rebuild an allow-list for, and (b) a brand-new product is
// visible to everyone the instant it's created, with no "remember to grant
// it" step anywhere. This inverse (store what's visible instead) reads as
// the more obvious shape -- resist "fixing" it back: it would silently hide
// every product from every user until someone remembers to grant it.
//
// Cascades on delete (unlike OptionCompatibility's ON DELETE SET NULL for
// seriesId/productId): a hidden row means nothing once its user or its
// series/product is gone, so removing either must never leave an orphaned
// row behind -- see migration z22_catalog_visibility_per_user.
model CatalogVisibility {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId  String? // whole series hidden for this user
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  productId String? // or a single product hidden for this user
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  // No separate index on seriesId or productId, unlike the same-shaped pair
  // on OptionCompatibility above. Every read of this table starts from a user
  // -- getHiddenCatalogIds (src/lib/queries/catalog-visibility.ts),
  // getUserVisibility (queries/catalog-visibility-admin.ts) and
  // setUserVisibility (actions/catalog-visibility.ts) all filter on `userId`
  // and nothing else, which the unique below already serves as its leftmost
  // column. The series/product columns are only ever *written*, and the
  // cascade that reads them fires at most once per catalogue deletion against
  // a table holding a handful of rows per user. Nothing to gain.
  @@unique([userId, seriesId, productId])
}

model Price {
  id          String   @id @default(cuid())
  regionId    String
  region      Region   @relation(fields: [regionId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionId    String?
  option      Option?  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  needsReview Boolean  @default(false) // imported gaps: M3390 TBD etc.

  @@unique([productId, regionId])
  @@unique([optionId, regionId])
  @@index([regionId])
}

model Company {
  id       String  @id @default(cuid())
  name     String
  street   String?
  city     String?
  state    String?
  postcode String?
  country  String? // ISO 3166-1 alpha-2 code going forward (see src/lib/countries.ts); pre-migration rows may still hold free text -- rendered via displayCountry().
  website  String?
  taxId    String?
  notes    String?

  // Delivery address: manufacturing/warehouse site, distinct from the main
  // (billing/office) address above -- owner: "client office is not always
  // the manufacturing site; delivery address matters." `deliverySameAsMain`
  // defaults true so the common case (one address) needs no extra input;
  // the delivery* fields below are only meaningful when it's false, and are
  // left populated-but-ignored if a company later flips back to true rather
  // than being cleared, so re-enabling "different address" restores the
  // previous entry instead of losing it.
  deliverySameAsMain  Boolean @default(true)
  deliveryStreet      String?
  deliveryCity        String?
  deliveryState       String?
  deliveryPostcode    String?
  deliveryCountry     String? // ISO 3166-1 alpha-2 code, same convention as `country`.
  deliveryContactName String?
  deliveryPhone       String? // Stored E.164 when parseable (see validatePhone in src/lib/phone.ts), raw otherwise.
  deliveryNotes       String?

  regionId   String
  region     Region     @relation(fields: [regionId], references: [id])
  ownerId    String?
  owner      User?      @relation("CompanyOwner", fields: [ownerId], references: [id])
  industryId String?
  industry   Industry?  @relation(fields: [industryId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  documents  Document[]
  createdAt  DateTime   @default(now())

  @@index([ownerId])
  @@index([industryId]) // renaming an industry shows an affected-company count first ("Used by 14 companies"), counted by industryId
}

model Contact {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  position        String?
  isPrimary       Boolean          @default(false)
  documents       Document[]
  signingRequests SigningRequest[]

  @@index([companyId])
}

// Lookup table rather than free text on Company: the list is bulk-imported
// (scripts/import-industries.ts) and picked hundreds of times, so an
// industry has to be one row every company points at instead of a string
// repeated with drifting spellings -- that is what makes the inline rename
// in industry-picker.tsx a real fix rather than a per-company patch.
// Global, not per-region: an industry means the same thing in AU and US.
model Industry {
  id        String    @id @default(cuid())
  name      String    @unique // Case-insensitive uniqueness is enforced by a separate functional index (Industry_name_lower_key) in the 10_industry_and_production_spec migration -- Prisma cannot declare that, so @unique alone is not the whole story.
  companies Company[]
}

model Document {
  id                String           @id @default(cuid())
  status            DocumentStatus   @default(DRAFT)
  number            String?          @unique // Q-AU-2026-001, assigned on finalize
  companyId         String? // set once the client step of the builder is completed
  company           Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId         String?
  contact           Contact?         @relation(fields: [contactId], references: [id])
  authorId          String
  author            User             @relation(fields: [authorId], references: [id])
  regionId          String
  region            Region           @relation(fields: [regionId], references: [id])
  issueDate         DateTime         @default(now())
  validityDays      Int?
  currency          String
  taxName           String
  taxRate           Decimal          @db.Decimal(5, 2)
  // DELIVERED (default) or EX_WORKS -- an Ex Works quote's tax is zeroed by
  // recalcDocument (src/lib/actions/documents.ts), the single caller that
  // resolves a document's effective tax rate; taxName/taxRate above are left
  // untouched (they're the region's nominal figures, unrelated to this
  // per-document override). finalizeDocument freezes nothing new for this --
  // the terms live on the document itself, not the entitySnapshot.
  deliveryTerms     DeliveryTerms    @default(DELIVERED)
  entitySnapshot    Json? // frozen on finalize
  // A discount is a mode + value (see the DiscountMode enum comment above) —
  // discountValue is a plain percentage (0..100) when discountMode is
  // PERCENT, or a cash amount in the document's own currency when AMOUNT;
  // null means no discount is set, regardless of mode. Enforced against
  // Region.maxDiscountPct — see setDocumentDiscount in
  // src/lib/actions/documents.ts.
  discountMode      DiscountMode     @default(PERCENT)
  discountValue     Decimal?         @db.Decimal(12, 2)
  subtotal          Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal          @default(0) @db.Decimal(12, 2)
  total             Decimal          @default(0) @db.Decimal(12, 2)
  notes             String?
  // Quotation-first pricing display (owner spec): a quote's total is always
  // shown up top regardless of these, but the per-item/per-option detail in
  // the investment summary only renders when the corresponding toggle is on
  // — see setPriceDisplay in src/lib/actions/documents.ts and
  // buildQuotationData in src/lib/quotation-data.ts.
  showItemPrices    Boolean          @default(false)
  showOptionPrices  Boolean          @default(false)
  // Salesperson commission, frozen on finalize -- see finalizeDocument
  // (src/lib/actions/finalize.ts), alongside entitySnapshot above. Before
  // FINAL, the builder always computes commission live (see
  // getDocumentForBuilder, src/lib/queries/documents.ts) so a draft never
  // shows a stale figure; once FINAL, the builder reads these three columns
  // instead, so a later change to the commission-tier table (Setting key
  // "commission.tiers") never rewrites what an already-issued quote is
  // recorded as having paid out. All three nullable together: a DRAFT (or a
  // FINAL document issued before this migration) has never had commission
  // frozen, and a document finalized while no commission-tier table was
  // configured (`CommissionResult`'s "null means unconfigured, never
  // $0.00" rule -- src/lib/pricing.ts) freezes all three as null too,
  // preserving that same distinction rather than collapsing it to a
  // misleading 0. Re-finalizing (after `unfinalizeDocument`) overwrites all
  // three with a fresh computation, exactly like entitySnapshot above --
  // there is no way to "keep the old commission" across a re-finalize.
  commissionAmount  Decimal?         @db.Decimal(12, 2)
  commissionRatePct Decimal?         @db.Decimal(5, 2)
  commissionBase    Decimal?         @db.Decimal(12, 2)
  signingStatus     SigningStatus    @default(NOT_SENT)
  // The archived signed PDF: the exact bytes the client saw when they
  // confirmed, plus their digest. Generated once at completion rather than
  // re-rendered on demand, so a later template change cannot rewrite what a
  // signed quote looks like. Cannot be orphaned: deletion is DRAFT-only,
  // SIGNED implies FINAL, and unfinalize is blocked at SIGNED.
  signedPdfName     String?
  signedPdfSha256   String?
  completedAt       DateTime?
  signatures        Signature[]
  signingRequests   SigningRequest[]
  // The setup image: one photo/render of the whole configuration (cutter +
  // table + spreader together), usually already produced in SketchUp and
  // shown to the customer before the quote is drawn up -- owner: "the most
  // persuasive thing in the quote". One per quote, not per item, on purpose:
  // the point is showing every item together, not illustrating any single
  // line. A stored `/api/files/<name>` URL (same shape as every other image
  // column -- `Region.logoUrl`, `User.image`, `Product.imageUrl`), resolved
  // through `ImageResolver` by `toSheetData` (src/lib/sheet-data.ts) exactly
  // like the logo and the author's avatar. `null` renders nothing at all on
  // the printed quote -- no frame, no placeholder -- see the `heroImage`
  // block in quotation-sheet.tsx.
  heroImageUrl      String?
  // Per-quote overrides of the region's standard-terms figures — null
  // means inherit. Delivery and warranty are negotiated per deal, and a
  // signed quote promising 14 weeks when the salesperson agreed 10 is a
  // commitment nobody made.
  deliveryWeeks     Int?
  installationDays  Int?
  trainingDays      Int?
  warrantyMonths    Int?
  // Every rendered document body and every item's category copy, frozen
  // when the quote went FINAL, with placeholders already substituted.
  // Fixing a typo in General Conditions must not rewrite a quote signed
  // three months ago. Written by finalizeDocument alongside
  // entitySnapshot; overwritten wholesale on a re-finalize after
  // unfinalizeDocument, exactly like entitySnapshot and the commission
  // columns. Null on a DRAFT and on any quote finalised before this
  // column existed — buildQuotationData falls back to live text then.
  documentsSnapshot Json?
  exclusions        DocumentExclusion[]
  items             DocumentItem[]
  lines             DocumentLine[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([companyId])
  @@index([authorId])
  @@index([regionId, status])
  // listDocuments (src/lib/queries/documents.ts) is the app's front door for
  // an ADMIN and sorts newest-edited-first with no WHERE at all, so the sort
  // is the whole cost of the query. A MANAGER's variant filters on authorId
  // (indexed above) and then sorts, which this cannot help with -- a
  // composite (authorId, updatedAt) would, but it would leave the ADMIN case,
  // the one that reads every row, unserved. Indexing updatedAt alone covers
  // the unbounded read; the scoped read is bounded by one author's documents
  // either way.
  @@index([updatedAt])
  // Nothing queries documents *by* contact, but deleteContact
  // (src/lib/actions/clients.ts) removes Contact rows, and this FK is
  // ON DELETE NO ACTION -- so Postgres must prove no Document references the
  // contact before every such delete. Unindexed, that proof is a sequential
  // scan of the largest and fastest-growing table in the schema. companyId
  // and authorId above are indexed on the same reasoning; contactId was
  // simply missed when they were added.
  @@index([contactId])
}

model DocumentItem {
  id             String         @id @default(cuid())
  documentId     String
  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId      String?
  // SetNull is written out rather than left to Prisma's default for an
  // optional relation (which is also SetNull) because it is a decision, not
  // an accident: a finalized quote must survive its product being deleted
  // from the catalogue. Everything the quote prints is snapshotted on this
  // row (code, name, description, unitPrice, listPrice, imageUrl below), so
  // losing the link costs a FINAL document nothing. A DRAFT is the other
  // case -- a nulled link there would be a phantom line, priced and totalled,
  // pointing at nothing -- which is why the catalogue import
  // (src/lib/actions/catalog-import.ts) deletes a draft's items and lines
  // itself, then recalculates, before the product row goes. See
  // docs/plans/2026-09-05-catalog-import-export.md §1.
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  sortOrder      Int            @default(0)
  code           String // snapshot
  name           String // snapshot
  description    String? // snapshot
  unitPrice      Decimal        @db.Decimal(12, 2) // snapshot -- what the customer is actually charged; a salesperson can hand-edit this (see setItemUnitPrice, src/lib/actions/documents.ts), including down to 0.
  // The catalogue price at the moment this row was added -- never shown to
  // the customer, only used (alongside unitPrice above) to compute the
  // region discount-cap "concession" a manual price represents (see the
  // documentConcession comment on PricingTotals in src/lib/pricing.ts).
  // Null for a row added before this column existed; migration
  // z13_line_list_price backfills those to unitPrice so they read as "no
  // concession". Nullable rather than defaulted to unitPrice at the type
  // level so "never priced by hand" stays distinguishable in the data.
  listPrice      Decimal?       @db.Decimal(12, 2)
  // Same mode + value shape as Document.discountMode/discountValue above —
  // see the DiscountMode enum comment.
  discountMode   DiscountMode   @default(PERCENT)
  discountValue  Decimal?       @db.Decimal(12, 2)
  serialNumber   String?
  showImage      Boolean        @default(false)
  // Sales-side production choices the price list does not carry: screen side
  // (+Y/-Y), knife size, voltage, drills, EasyLoader table sections. Shape
  // varies by series -- validated by src/lib/validation/production-spec.ts,
  // never read as free-form JSON. Deliberately NOT covered by the finalize
  // lock: it carries no commercial meaning, so correcting a knife size must
  // not force an unfinalize/refinalize cycle that churns document numbering.
  productionSpec Json?
  imageUrl       String?
  lines          DocumentLine[]

  @@index([documentId])
  // deleteProduct (src/lib/actions/catalog.ts) refuses to delete a catalogue
  // product that any document still quotes, and proves that with a
  // `documentItem.count({ where: { productId } })`. That count is also what
  // the answer hinges on, so it runs on every attempted delete whether or not
  // the product is in use. Postgres needs the same lookup a second time for
  // the FK check on the delete that follows.
  @@index([productId])
}

model DocumentLine {
  id          String        @id @default(cuid())
  documentId  String
  document    Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  itemId      String? // null = document-level line
  item        DocumentItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind        LineKind
  refId       String? // optionId or productId
  code        String?
  name        String
  description String?
  qty         Int           @default(1)
  unitPrice   Decimal       @db.Decimal(12, 2) // what the customer is actually charged -- see DocumentItem.unitPrice's comment; hand-editable for an OPTION line via setLineUnitPrice, not offered for a CUSTOM (extra) line, which has no catalogue price to concede against.
  // Catalogue price snapshot -- see DocumentItem.listPrice's comment. Only
  // ever populated for an OPTION line (the option's price at selection
  // time); a CUSTOM line has no catalogue entry to snapshot and stays null.
  listPrice   Decimal?      @db.Decimal(12, 2)
  attributes  Json? // { metres: 4, tables: 2 }
  showImage   Boolean       @default(false)
  // A custom extra line has no catalogue entry to inherit an image from, so
  // it carries its own (option lines keep using the catalogue image via
  // `refId`). Set together with `showImage` by `addCustomLine`.
  imageUrl    String?
  sortOrder   Int           @default(0)

  @@index([documentId])
  @@index([itemId])
  // `refId` is the catalogue id a line was created from (see the column
  // above), and it is only ever read in the "is this catalogue row still in
  // use" direction: deleteProduct filters `{ refId, kind: "PRODUCT" }` and
  // deleteOption filters `{ refId }` with no kind at all (both
  // src/lib/actions/catalog.ts), and prisma/seed.ts counts
  // `{ refId, kind: "OPTION" }` before retiring an option, choosing between
  // deleting it and merely deactivating it.
  //
  // refId leads, kind follows -- not the other way round. refId is a cuid and
  // near-unique; kind has three values, so a kind-first index would land the
  // scan on roughly a third of the table before refId narrowed anything, and
  // could not serve deleteOption's kind-less filter at all. This order serves
  // all three call sites from one index.
  @@index([refId, kind])
}

// `model ContentBlock` stood here until migration z37_drop_content_block.
// It held three unrelated kinds of text as key-prefixed fragments: category
// copy (`machine.*`, `equipment.*`), per-option copy (`option.*`), and the
// legal documents (`terms.*`, `conditions.*`, `rsp.*`). All three moved to
// where they belong -- `Series.quoteDescription`, and `QuoteDocument` below
// -- so nothing resolved a block key any more and the two
// `Product`/`Option.contentBlockKey` columns went with it.

/// One whole legal document printed on a quote — Terms, General Conditions
/// of Sale, the RSP agreement, and whatever a region adds later. Replaces
/// the ContentBlock rows that held the same text as 7 and 14 separate
/// fragments: a lawyer hands over a document, not a list of clauses, and a
/// region variant is a copy of the whole thing rather than an override per
/// piece.
///
/// `regionId: null` is the global default; a non-null `regionId` is that
/// region's own version, resolved by the same two-pass rule ContentBlock
/// used (defaults first, then this region's rows, so an override wins
/// regardless of array order). A row may exist for a region with NO global
/// default — that is how a region-only document works, e.g. a Data
/// Processing Agreement offered only by an EU entity.
model QuoteDocument {
  id                String   @id @default(cuid())
  key               String // "terms" | "conditions" | "rsp" | future keys
  regionId          String?
  title             String // the printed heading
  body              String // HTML, may contain document-scope {{tokens}}
  sortOrder         Int      @default(0)
  /// Whether a new quote includes this document unless its author unticks
  /// it. Every document starts true; RSP is the one an author routinely
  /// turns off, for a small order nothing in the programme covers.
  includedByDefault Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  region            Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@unique([key, regionId])
  @@index([regionId])
}

/// A document an individual quote leaves out. Stores the document's `key`,
/// not its id, so the exclusion still means the same thing if the quote's
/// region changes and a different QuoteDocument row becomes the resolved
/// one. Absence means included — the common case writes no row at all.
model DocumentExclusion {
  documentId       String
  quoteDocumentKey String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, quoteDocumentKey])
}

model NumberSequence {
  id         String @id @default(cuid())
  regionCode String
  year       Int
  counter    Int    @default(0)

  @@unique([regionCode, year])
}

model Setting {
  key   String @id
  value Json
}

// A message from "Settings -> PathQuote Support" (any signed-in user) to
// whoever holds the DEVELOPER role -- see the Role enum's own comment. Kept
// small on purpose: who, when, subject, body, and just enough context to
// reproduce a report without a round trip back to the sender -- the role
// and region the sender held *at submission time* (not a live join to
// User/Region, which could read back something that had since changed) plus
// a best-effort app version (see src/lib/app-version.ts).
//
// Always written before an email is attempted (see submitSupportMessage,
// src/lib/actions/support.ts) -- a misconfigured SMTP transport must never
// mean the report simply vanishes; emailedAt/emailError record whether the
// notification actually went out so a developer reading this table directly
// can tell "nobody's seen this yet" from "sent, and probably read".
model SupportMessage {
  id         String    @id @default(cuid())
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  authorRole Role // snapshot of the sender's role at submission time
  regionId   String?
  region     Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  appVersion String?
  subject    String
  body       String
  createdAt  DateTime  @default(now())
  // Null until a send attempt succeeds. Distinguishes "never sent" from
  // "sent" without needing a separate boolean that could drift from it.
  emailedAt  DateTime?
  // The last send attempt's error message, if any -- cleared implicitly by
  // emailedAt being set on a later successful retry (there is no retry
  // mechanism yet, but the shape doesn't rule one out).
  emailError String?

  @@index([authorId])
}

// Admin-managed illustrations for a discrete production-spec choice (owner,
// relaying Ross: "rather than showing plus or minus, show that image... to
// someone in another language, they might get confused" -- a `+Y`/`-Y`
// screen-side dropdown carries almost nothing to a reader whose English
// isn't first). `field` names the spec key the diagram illustrates (the
// `DocumentItem.productionSpec` JSON key -- see production-spec-editor.tsx;
// today only "screenSide" is wired up, values "+Y"/"-Y") and `value` is one
// of that field's discrete choices, so `(field, value)` is the smallest model
// that binds one image to one exact answer -- `screenSide = "+Y"` and
// `screenSide = "-Y"` are two different rows, two different pictures. Deliberately
// generic rather than a `screenSideImageUrl` column on some settings
// singleton: the owner asked for exactly one field wired up today (screen
// side), but the same shape trivially extends to another discrete choice
// (knife size, voltage) later by adding rows under a new `field`, no schema
// change required -- see getSpecImages in src/lib/queries/spec-images.ts. No
// row for a given (field, value) means "no diagram uploaded yet" -- the
// builder falls back to a placeholder box, never a broken image.
model SpecImage {
  id        String   @id @default(cuid())
  field     String
  value     String
  imageUrl  String
  updatedAt DateTime @updatedAt

  @@unique([field, value])
}

// APPLIED: the transaction committed. FAILED: it rolled back, and `error`
// says why (a unique-code collision, a re-diff that no longer matched the
// preview, ...). There is no PENDING: a preview writes nothing, so nothing
// is recorded until the admin confirms.
enum CatalogImportStatus {
  APPLIED
  FAILED
}

// One row per confirmed catalogue import from Settings -> Import / Export
// (docs/plans/2026-09-05-catalog-import-export.md §3.5): who, when, which
// file, the per-sheet/per-bucket counts, and the full preview diff the admin
// confirmed. The diff is the point -- an import deletes rows and removes
// lines from other people's drafts, and without the before/after of every
// row a bad import could not be reconstructed. `counts` duplicates what
// `diff.counts` holds so the history list can render without loading the
// (potentially large) diff column.
//
// The user FK is left at Prisma's default (ON DELETE RESTRICT): an audit row
// must outlive nothing, and the app deactivates users rather than deleting
// them (User.active).
model CatalogImport {
  id        String              @id @default(cuid())
  createdAt DateTime            @default(now())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  fileName  String
  counts    Json
  diff      Json
  status    CatalogImportStatus
  error     String?

  // The history list reads newest-first with no other filter.
  @@index([createdAt])
}

// A frozen copy of one party's signature on one quote. `imageUrl` is a copy
// of the bytes, never a pointer to User.signatureUrl: a manager redrawing
// their signature next year must not silently rewrite it on every quote they
// have ever signed.
model Signature {
  id          String     @id @default(cuid())
  documentId  String
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role        SignerRole
  imageUrl    String
  signerName  String
  // Null for an AUTHOR whose User account has no email recorded (User.email
  // is required today, but this predates that guarantee and is kept
  // nullable rather than assumed). Always present for a CLIENT: the signing
  // page has no path to a signature without SigningRequest.email behind it.
  signerEmail String?
  signedAt    DateTime   @default(now())
  // ip and userAgent are null-by-design for an AUTHOR signature: the author
  // signs inside an authenticated session that already identifies them
  // (session -> User, logged wherever sessions are), so capturing a second,
  // weaker identifier here would add nothing. For a CLIENT signature they
  // are the audit trail -- the client signs on a public, unauthenticated
  // page, so this is the only record of who was on the other end.
  //
  // A third CHECK constraint was proposed alongside the two added in
  // migration z35 -- requiring `ip` to be set whenever role = CLIENT -- and
  // rejected: a client behind a proxy that strips `x-forwarded-for` would
  // then be unable to sign at all, turning a missing header into a blocked
  // signature. The evidentiary value of an IP does not justify refusing a
  // customer's signature, so both columns stay nullable for every role.
  ip          String?
  userAgent   String?

  @@unique([documentId, role])
}

// One row per send. A resend inserts a new row and revokes the previous one,
// so send history is preserved without a separate event table -- sentAt,
// firstViewedAt, revokedAt, declinedAt and Signature.signedAt already carry
// the whole audit trail between them.
//
// `expiresAt` is frozen at send time from the "signing.linkValidityDays"
// Setting rather than computed live, for the same reason finalizeDocument
// freezes Document.validityDays: an admin lowering the setting must not
// retroactively kill every outstanding client link.
model SigningRequest {
  id               String    @id @default(cuid())
  documentId       String
  document         Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // A convenience link to the contact record, not the audit trail -- `email`
  // below already snapshots the exact address the invite went to, the way
  // every other frozen-at-action-time field in this schema works (compare
  // DocumentItem's code/name/unitPrice snapshots). Nullable and SET NULL
  // instead of Prisma's default RESTRICT for a required relation: a contact
  // who was sent a quote for signature -- sent, expired, revoked, completed,
  // years ago, it makes no difference -- must still be deletable from
  // deleteContact (src/lib/actions/clients.ts), which has no pre-check and
  // no try/catch of its own. Keeping this required and RESTRICT would turn
  // any such contact permanently undeletable, surfacing to a manager as a
  // raw unhandled foreign-key exception rather than a message. Matches
  // Document.contactId's shape above for exactly the same reason.
  contactId        String?
  contact          Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  email            String
  // SHA-256 of the token. The token itself never reaches the database, so a
  // dump grants access to no quote.
  tokenHash        String    @unique
  expiresAt        DateTime
  sentAt           DateTime  @default(now())
  firstViewedAt    DateTime?
  revokedAt        DateTime?
  declinedAt       DateTime?
  declineReason    String?
  declineIp        String?
  // Symmetric with Signature.ip/userAgent above: declining, like signing, is
  // a terminal act by an unauthenticated visitor, and the audit trail should
  // not capture less about the one than the other. declineIp alone (without
  // this column) was the gap.
  declineUserAgent String?

  @@index([documentId])
}
